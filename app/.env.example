# devnet | mainnet-beta
NEXT_PUBLIC_CLUSTER=devnet
# Public URL of the site (Blinks + OG images need the real https URL in production)
NEXT_PUBLIC_SITE_URL=https://ontrace.space
# Browser RPC. Use a Helius/Triton/QuickNode URL on mainnet (free Helius key recommended).
NEXT_PUBLIC_RPC_URL=
# Server RPC (optional, defaults to NEXT_PUBLIC_RPC_URL). Keep paid keys here.
SOLANA_RPC_URL=
# Priority fee in micro-lamports per compute unit (default 0 on devnet, 20000 on mainnet)
NEXT_PUBLIC_PRIORITY_FEE=
# Database (filled in automatically when you connect Upstash Redis in Vercel → Storage)
KV_REST_API_URL=
KV_REST_API_TOKEN=
